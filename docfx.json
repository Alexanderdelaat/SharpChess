{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": ".",
          "files": [ "src/SharpChess.Api/SharpChess.Api.csproj" ]
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      {
        "files": [ "**/*.{md,html,yml}" ],
        "exclude": [ "_site/**", "docs/index.html", "coverage-report/**" ]
      }
    ],
    "resource": [
      {
        "files": [ "images/**" ]
      },
      {
        "files": [ "coverage-report/**" ]
      }
    ],
    "output": "_site",
    "template": [ "default", "modern", "templates/sharpchess" ],
    "globalMetadata": {
      "_appName": "SharpChess",
      "_appTitle": "SharpChess",
      "_appLogoPath": "images/chess-logo.svg",
      "_appFooter": "<span>Made by Alexander</span>",
      "_enableSearch": true,
      "_disableSideFilter": true
    }
  }
}
